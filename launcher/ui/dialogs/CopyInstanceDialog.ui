        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="copySavesCheckbox">
        <property name="toolTip">
         <string>Copy the saves of the instance into the new one. Copying from the Steam instance only reads your saves, it never changes them.</string>
        </property>
        <property name="text">
         <string>Copy saves</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="copySettingsCheckbox">
