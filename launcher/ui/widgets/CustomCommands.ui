   <item>
    <widget class="QLabel" name="labelCustomCmdsDescription">
     <property name="text">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The pre-load command runs before mods are deployed, the pre-launch command runs right before the game starts and the post-exit command runs after the game and everything it started have exited.&lt;/p&gt;&lt;p&gt;They run with the same environment as the game (an isolated instance's own Documents and AppData) plus:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;$INST_NAME - name of the instance&lt;/li&gt;&lt;li&gt;$INST_ID - ID of the instance (its folder name)&lt;/li&gt;&lt;li&gt;$INST_DIR - absolute path of the instance&lt;/li&gt;&lt;li&gt;$INST_GAME_DIR - the game folder&lt;/li&gt;&lt;li&gt;$INST_DATA_DIR - the folder loose mod files go in&lt;/li&gt;&lt;li&gt;$INST_PROFILE_DIR - the instance's profile folder&lt;/li&gt;&lt;li&gt;$INST_MY_GAMES_DIR - the game's My Games folder&lt;/li&gt;&lt;li&gt;$INST_GAME - the Nexus Mods game id&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="textInteractionFlags">
      <set>Qt::TextInteractionFlag::LinksAccessibleByMouse|Qt::TextInteractionFlag::TextSelectableByMouse</set>
     </property>
    </widget>
